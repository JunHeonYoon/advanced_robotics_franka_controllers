<?xml version="1.0" ?>
<launch>
  <arg name="robot_ip" default="172.16.3.3" />
  <arg name="load_gripper" default="true" />

  <param name="robot_description" command="xacro '$(find dyros_panda_env_description)/robots/panda_table_env.urdf.xacro'"/>
  <param name="robot_description_semantic" textfile="$(find panda_table_moveit_config)/config/panda.srdf" />

  <include file="$(find franka_control)/launch/franka_control.launch" >
    <arg name="robot_ip" value="$(arg robot_ip)" />
    <arg name="load_gripper" value="$(arg load_gripper)" />
    <arg name="load_robot_description" value="false"/>
  </include>

  
  <node pkg="haptic_ros_driver" type="haptic_ros_driver" name="haptic_ros_driver"/>

  <rosparam command="load" file="$(find advanced_robotics_franka_controllers)/config/advanced_robotics_franka_controllers.yaml" />
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen"  args="jh_controller_position"/>
  <!-- <node pkg="rviz" type="rviz" output="screen" name="rviz" args="-d $(find advanced_robotics_franka_controllers)/launch/jh_rviz.rviz"/> -->

</launch>
